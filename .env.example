# Local demo is explicit and only intended for local development.
APP_MODE=demo
APP_URL=http://127.0.0.1:3050

# Set APP_MODE=supabase to use your own Supabase project and Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Required only by the explicit local-to-cloud migration command.
SUPABASE_MIGRATION_PROJECT_REF=
# Optional four-role demo login menu. Only available on localhost, including Supabase mode.
RUPA_DEMO_MENU=0

# Optional real Midtrans Sandbox integration. Never use production keys here.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Optional private AI worker (see ai-worker/README.md).
AI_WORKER_URL=
AI_WORKER_TOKEN=
